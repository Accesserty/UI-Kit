{
  "name": "accesserty-ui-kit",
  "version": "3.0.0",
  "description": "Accesserty UI Kit is a library of web components built with Web Components technology, designed with built-in accessibility semantics, structure, and interaction support by default.",
  "author": "Accesserty",
  "keywords": [
    "accessibility",
    "a11y",
    "web accessibility",
    "digital accessibility",
    "css framework",
    "ui kit",
    "web components"
  ],
  "homepage": "https://accesserty.com/en/uikit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accesserty/UI-Kit.git"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/accesserty-ui-kit.js",
  "module": "dist/accesserty-ui-kit.js",
  "types": "dist/accesserty-ui-kit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/accesserty-ui-kit.d.ts",
      "default": "./dist/accesserty-ui-kit.js"
    },
    "./min": {
      "types": "./dist/accesserty-ui-kit.d.ts",
      "default": "./dist/accesserty-ui-kit.min.js"
    },
    "./vue": {
      "types": "./dist/accesserty-ui-kit-vue.d.ts",
      "default": "./dist/accesserty-ui-kit-vue.js"
    },
    "./nuxt": {
      "types": "./dist/accesserty-ui-kit-nuxt.d.ts",
      "default": "./dist/accesserty-ui-kit-nuxt.js"
    },
    "./react": {
      "types": "./dist/accesserty-ui-kit-react.d.ts",
      "default": "./dist/accesserty-ui-kit-react.js"
    },
    "./ssr": {
      "types": "./dist/accesserty-ui-kit-ssr.d.ts",
      "default": "./dist/accesserty-ui-kit-ssr.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "test:css": "node test/browser/css-contract.mjs",
    "test:controls": "node test/browser/controls.mjs",
    "test:pagination": "node test/browser/pagination.mjs",
    "test:docs": "node test/docs-contract.mjs",
    "test:reserve": "node test/browser/reserve-contract.mjs",
    "test:visibility": "node test/browser/visibility.mjs",
    "test:demo-safety": "node test/browser/demo-safety.mjs",
    "test:form-flow": "node test/browser/form-flow.mjs",
    "test:dropdown:chrome": "node test/browser/dropdown.mjs chrome",
    "test:firefox": "node test/browser/webdriver-suite.mjs firefox",
    "test:safari": "node test/browser/webdriver-suite.mjs safari",
    "test": "web-test-runner test/*.test.js --node-resolve --concurrency 1",
    "build": "vite build && node scripts/build-integrations.mjs && node scripts/build-components.mjs",
    "test:ssr-stream": "node test/ssr-stream.mjs"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "rollup": "4.62.2",
    "vite": "^6.3.4"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
