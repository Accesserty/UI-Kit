{
  "name": "accesserty-ui-kit",
  "version": "2.0.0",
  "description": "Accesserty UI Kit is a library of web components built with Web Components technology, designed with built-in accessibility semantics, structure, and interaction support by default.",
  "author": "Accesserty",
  "keywords": [
    "accessibility",
    "a11y",
    "web accessibility",
    "digital accessibility",
    "css framework",
    "ui kit",
    "web components"
  ],
  "homepage": "https://github.com/Accesserty/UI-Kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accesserty/UI-Kit.git"
  },
  "private": false,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/accesserty-ui-kit.js",
  "module": "dist/accesserty-ui-kit.js",
  "exports": {
    ".": "./dist/accesserty-ui-kit.js",
    "./min": "./dist/accesserty-ui-kit.min.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "test:css": "node test/browser/css-contract.mjs",
    "test:controls": "node test/browser/controls.mjs",
    "test:pagination": "node test/browser/pagination.mjs",
    "test:docs": "node test/docs-contract.mjs",
    "test:visibility": "node test/browser/visibility.mjs",
    "test:demo-safety": "node test/browser/demo-safety.mjs",
    "test:form-flow": "node test/browser/form-flow.mjs",
    "test:dropdown:chrome": "node test/browser/dropdown.mjs chrome",
    "test": "web-test-runner test/*.test.js --node-resolve --concurrency 1",
    "build": "vite build"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "vite": "^6.3.4"
  }
}
